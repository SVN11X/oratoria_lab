{
  "name": "oratoria-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm prepare:wasm && pnpm --filter @oratoria/web dev",
    "build": "pnpm --filter @oratoria/web build",
    "preview": "pnpm --filter @oratoria/web preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm verify:build",
    "desktop:dev": "pnpm --filter @oratoria/desktop dev",
    "desktop:build": "pnpm --filter @oratoria/desktop build",
    "prepare:wasm": "node scripts/copy-wasm.mjs",
    "benchmark": "node --experimental-strip-types scripts/benchmark.ts"
  },
  "devDependencies": {
    "vite": "7.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "5.9.3",
    "tailwindcss": "4.3.3",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "9.39.5",
    "@eslint/js": "9.39.5",
    "typescript-eslint": "8.71.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "prettier": "3.9.10",
    "vitest": "4.1.11",
    "@playwright/test": "1.64.0",
    "@axe-core/playwright": "4.13.0",
    "fake-indexeddb": "6.2.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/node": "24.19.2",
    "onnxruntime-web": "1.22.0-dev.20250409-89f8206ba4",
    "@oratoria/core": "workspace:*",
    "@oratoria/audio": "workspace:*",
    "@oratoria/evaluation": "workspace:*",
    "@oratoria/simulation": "workspace:*",
    "@oratoria/storage": "workspace:*",
    "@oratoria/export": "workspace:*",
    "@oratoria/model-manager": "workspace:*",
    "@oratoria/transcription": "workspace:*"
  }
}
